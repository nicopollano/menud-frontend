    "next": "^15.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "framer-motion": "^10.12.0",
    "zod": "^3.24.2",
    "@tailwindcss/postcss": "^4.1.14",
    "@radix-ui/react-slot": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^1.0.0"
  },
  "devDependencies": {
    "@ristokit/eslint-config": "workspace:^",
    "@ristokit/typescript-config": "workspace:*",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "typescript": "^5.7.3"
  }
